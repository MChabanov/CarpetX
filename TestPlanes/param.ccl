# Parameter definitions for thorn TestPlanes

CCTK_REAL refined_radius "Half-size of the cube flagged for refinement"
{
  (0:* :: "any positive size"
} 8.0

CCTK_REAL refined_center_x "x coordinate of the refined cube centre"
{
  *:* :: "anything"
} 16.0

CCTK_REAL refined_center_y "y coordinate of the refined cube centre"
{
  *:* :: "anything"
} 16.0

CCTK_REAL refined_center_z "z coordinate of the refined cube centre"
{
  *:* :: "anything"
} 16.0
