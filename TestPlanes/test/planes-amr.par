## 2D plane output on a 3-level AMR hierarchy.
##
## Identical field, domain, centerings and plane specs as
## planes-single-level.par, but with three refinement levels covering a cube of
## half-width 4 about the domain centre (4,8,6): x in [0,8], y in [4,12],
## z in [2,10]. All six planes pass through that cube, so each plane intersects
## every level -- exercising per-level snapping, the Silo AMR mrgtree level
## shadowing, and the openPMD per-(patch,level) hierarchy attributes. Because
## TestPlanes re-applies the analytic field at initial and postregrid, every
## level holds f exactly, independent of prolongation.

ActiveThorns = "
    CarpetX
    IOUtil
    TestPlanes
"

Cactus::cctk_itlast = 0
Cactus::presync_mode = "mixed-error"

# Distinct cell count and non-zero origin per axis; dx = 1 on the coarse level.
CarpetX::ncells_x = 16
CarpetX::ncells_y = 20
CarpetX::ncells_z = 24

CarpetX::xmin = -4.0
CarpetX::ymin = -2.0
CarpetX::zmin = -6.0
CarpetX::xmax = 12.0
CarpetX::ymax = 18.0
CarpetX::zmax = 18.0

CarpetX::boundary_x = "linear extrapolation"
CarpetX::boundary_y = "linear extrapolation"
CarpetX::boundary_z = "linear extrapolation"
CarpetX::boundary_upper_x = "linear extrapolation"
CarpetX::boundary_upper_y = "linear extrapolation"
CarpetX::boundary_upper_z = "linear extrapolation"

# Three levels refining a cube of half-width 4 about the domain centre (4,8,6).
CarpetX::max_num_levels = 3
CarpetX::regrid_every = 1
Driver::regrid_error_threshold = 0.5

CarpetX::ghost_size = 1
CarpetX::prolongation_type = "conservative"
CarpetX::prolongation_order = 1

CarpetX::blocking_factor_x = 2
CarpetX::blocking_factor_y = 2
CarpetX::blocking_factor_z = 2

TestPlanes::refined_center_x = 4.0
TestPlanes::refined_center_y = 8.0
TestPlanes::refined_center_z = 6.0
TestPlanes::refined_radius = 4.0

IO::out_dir = $parfile
IO::out_every = 1
IO::out_fileinfo = "axis labels"
IO::parfile_write = no

CarpetX::out_metadata = no

# All eight centerings, written on the three principal planes (at the domain
# centre) plus one offset per direction; all lie inside the refined cube so
# they cross every level.
CarpetX::out_silo_plane_vars = "
    TestPlanes::gf000
    TestPlanes::gf001
    TestPlanes::gf010
    TestPlanes::gf011
    TestPlanes::gf100
    TestPlanes::gf101
    TestPlanes::gf110
    TestPlanes::gf111
"
CarpetX::out_silo_planes = "xy:6.0, xz:8.0, yz:4.0, xy:8.0, xz:10.0, yz:2.0"
CarpetX::out_silo_planes_every = 1

CarpetX::out_openpmd_plane_vars = "
    TestPlanes::gf000
    TestPlanes::gf001
    TestPlanes::gf010
    TestPlanes::gf011
    TestPlanes::gf100
    TestPlanes::gf101
    TestPlanes::gf110
    TestPlanes::gf111
"
CarpetX::out_openpmd_planes = "xy:6.0, xz:8.0, yz:4.0, xy:8.0, xz:10.0, yz:2.0"
CarpetX::out_openpmd_planes_every = 1

CarpetX::out_planes_int_precision = 4
CarpetX::out_planes_frac_precision = 3
