# Schedule definitions for thorn TestPlanes

STORAGE: gf000
STORAGE: gf001
STORAGE: gf010
STORAGE: gf011
STORAGE: gf100
STORAGE: gf101
STORAGE: gf110
STORAGE: gf111

SCHEDULE TestPlanes_SetError AT postinitial
{
  LANG: C
  WRITES: CarpetXRegrid::regrid_error(interior)
} "Flag the refined region"

# Set the analytic field on the interior and then SYNC to fill ghost zones
# (inter-box copy, the linear-extrapolation outer boundary, and coarse-fine
# prolongation). Writing the interior and syncing -- rather than writing
# "everywhere" -- keeps CarpetX's validity tracking consistent with how a newly
# regridded level is actually populated, so the poison check after
# MakeNewLevelFromCoarse does not fire on the not-yet-synced ghost zones.
# Scheduling at both initial and postregrid keeps every (re)created level
# holding f exactly, independent of prolongation.
SCHEDULE GROUP TestPlanes_SetValue AT initial
{
} "Set up analytic test data"

SCHEDULE GROUP TestPlanes_SetValue AT postregrid
{
} "Re-apply analytic test data after regridding"

SCHEDULE TestPlanes_Set IN TestPlanes_SetValue
{
  LANG: C
  WRITES: gf000(interior), gf001(interior), gf010(interior), gf011(interior),
          gf100(interior), gf101(interior), gf110(interior), gf111(interior)
} "Set analytic test data f(x,y,z) = x + 100 y + 10000 z on the interior"

SCHEDULE TestPlanes_Sync IN TestPlanes_SetValue AFTER TestPlanes_Set
{
  LANG: C
  SYNC: gf000
  SYNC: gf001
  SYNC: gf010
  SYNC: gf011
  SYNC: gf100
  SYNC: gf101
  SYNC: gf110
  SYNC: gf111
} "Synchronize analytic test data"
